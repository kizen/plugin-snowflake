{
  "name": "Write Data",
  "api_name": "snowflakewrite",
  "action_description": "Connects to Snowflake and executes a query to write data",
  "plugin_description": "Snowflake connector",
  "action_type": "snowflake_write_data",
  "runtime": "python 3.12",
  "secrets": ["snowflake_connection"],
  "inputs": [
    {
      "name": "database",
      "label": "Database",
      "data_type": "string",
      "required": true,
      "script_alias": "database"
    },
    {
      "name": "query",
      "label": "Query",
      "data_type": "string",
      "required": true,
      "script_alias": "query"
    },
    {
      "name": "return_single_value",
      "label": "Return Single Value",
      "data_type": "boolean",
      "required": true,
      "script_alias": "result_single_value",
      "default": true
    },
    {
      "name": "connection_secret_tag",
      "label": "Connection Secret Tag",
      "data_type": "string",
      "required": false,
      "script_alias": "connection_secret_tag"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "label": "Result",
      "data_type": "string",
      "required": true,
      "script_alias": "result"
    },
    {
      "name": "result_status",
      "label": "Result Status",
      "data_type": "string",
      "required": true,
      "script_alias": "result_status"
    }
  ]
}
