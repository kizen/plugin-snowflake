{
  "name": "Write Data",
  "api_name": "snowflakewrite",
  "action_description": "Connects to Snowflake and executes a query to write data",
  "runtime": "python 3.12",
  "secrets": ["snowflake_connection"],
  "inputs": [
    {
      "name": "database",
      "label": "Database",
      "data_type": "string",
      "required": true
    },
    {
      "name": "query",
      "label": "Query",
      "data_type": "string",
      "required": true
    },
    {
      "name": "return_single_value",
      "label": "Return Single Value",
      "data_type": "boolean",
      "required": true
    },
    {
      "name": "connection_secret_tag",
      "label": "Connection Secret Tag",
      "data_type": "string",
      "required": false,
      "input_source": "static_value"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "label": "Result",
      "data_type": "string",
      "required": true
    },
    {
      "name": "result_status",
      "label": "Result Status",
      "data_type": "string",
      "required": true
    }
  ]
}
